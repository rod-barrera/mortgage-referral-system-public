{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM"],
    "rootDir": "frontend",
    "outDir": "src/main/resources/static/js",
    "strict": true,
    "noEmitOnError": true,
    "removeComments": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["frontend/**/*.ts"]
}
